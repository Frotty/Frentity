package Players
import public LinkedList
import ClosureEvents
import ClosureTimers

/** A list of all players that are still in the game */
public constant ALL_PLAYERS = new LinkedList<player>()

interface OnPlayerLeave
	function onLeave(player leaver)

constant onLeaveListeners = new LinkedList<OnPlayerLeave>()

/** Add a listener for when a player leaves the game. Listeners are called in registration order. */
public function onPlayerLeave(OnPlayerLeave onLeave)
	onLeaveListeners.add(onLeave)

init
	nullTimer() ->
		for i = 0 to bj_MAX_PLAYER_SLOTS - 1
			if players[i].isIngame()
				ALL_PLAYERS.add(players[i])

		EventListener.add(EVENT_PLAYER_LEAVE) ->
			let leaver = GetTriggerPlayer()
			ALL_PLAYERS.remove(leaver)
			for listener in onLeaveListeners
				listener.onLeave(leaver)

		// Only announce leaves if the map has not said what it wants to do instead. This used to
		// overwrite the map's own listener, because it runs a tick after the map's init.
		if onLeaveListeners.isEmpty()
			onPlayerLeave() p ->
				printTimed(p.getNameColored() + " has left the game", 15.)
