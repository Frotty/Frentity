package DupletListModule
/** Turns a class into a linked list where each instance knows it's previous
	and next member in the list */
public module DupletListModule
	static thistype firstActive = null
	static thistype lastActive = null
	static thistype firstInactive = null
	static thistype lastInactive = null
	static int activeSize = 0
	static int inactiveSize = 0
	/** Iterators currently walking the active list. A node about to leave the list advances any
		iterator parked on it, so iteration never has to re-read a node it has already handed out.
		Re-reading is not safe: a destroyed node's id is handed straight back out by the allocator,
		so the "same" node can be a different, live object by the time the loop looks again. */
	static Iterator array openIterators
	static int openIteratorCount = 0
	thistype prev
	thistype next
	boolean active = true
	boolean linked = false

	construct()
		addToActive()

	function deactivate()
		if active and linked
			active = false
			removeFromActive()
			addToInactive()

	function activate()
		if not active and linked
			active = true
			removeFromInactive()
			addToActive()

	function remove()
		if not linked
			return
		if active
			active = false
			removeFromActive()
		else
			removeFromInactive()

	function removeFromActive()
		activeSize--
		// Step every iterator parked on this node past it, while next is still valid.
		for i = 0 to openIteratorCount - 1
			if openIterators[i].current == this
				openIterators[i].current = next
		if this != firstActive
			prev.next = next
		else
			firstActive = next
		if this != lastActive
			next.prev = prev	
		else
			lastActive = prev
		if firstActive != null
			if firstActive == lastActive
				firstActive.prev = null
			else
				firstActive.prev = lastActive
		linked = false
		prev = null
		next = null

	function removeFromInactive()
		inactiveSize--
		if this != firstInactive
			prev.next = next
		else
			firstInactive = next
		if this != lastInactive
			next.prev = prev	
		else
			lastInactive = prev
		if firstInactive != null
			if firstInactive == lastInactive
				firstInactive.prev = null
			else
				firstInactive.prev = lastInactive
		linked = false
		prev = null
		next = null
	
	function addToActive()
		activeSize++
		if activeSize == 1
			firstActive = this
			prev = null	
		else
			prev = lastActive
			lastActive.next = this
			firstActive.prev = this
		next = null
		lastActive = this
		linked = true

	function addToInactive()
		inactiveSize++
		if inactiveSize == 1
			firstInactive = this
			prev = null	
		else
			prev = lastInactive
			lastInactive.next = this
			firstInactive.prev = this
		next = null
		lastInactive = this
		linked = true

			
	ondestroy
		remove()
	
	/** an iterator which iterates over all instances of this class */
	static function iterator() returns Iterator
		return new Iterator()
		
	static class Iterator
		DupletListModule.thistype current = firstActive

		construct()
			openIterators[openIteratorCount] = this
			openIteratorCount++

		function hasNext() returns boolean
			return current != null

		function next() returns DupletListModule.thistype
			let res = current
			current = current.next
			return res

		function close()
			destroy this

		function reset()
			current = firstActive

		ondestroy
			// Compact the open-iterator list. Iterators are closed in any order, so find this one.
			var found = false
			for i = 0 to openIteratorCount - 1
				if not found and openIterators[i] == this
					found = true
					openIteratorCount--
					openIterators[i] = openIterators[openIteratorCount]
					openIterators[openIteratorCount] = null

class IterNode
	use DupletListModule
	var tag = 0

IterNode secondNode = null

function newNode(int tag) returns IterNode
	let n = new IterNode()
	n.tag = tag
	return n

function clearNodes()
	let itr = IterNode.iterator()
	for n from itr
		destroy n
	itr.close()

/* An element leaving the list while an iterator is parked on it used to strand that iterator: it
   handed out the dead node and then stopped on its cleared `next`, skipping every live element
   after it. Destroying the element the iterator has already cached is the case that hit hardest,
   because an entity update that terminates itself and one other entity does exactly that. */
@Test function iteratorSkipsRemovedNodesAndStillReachesTheTail()
	clearNodes()
	newNode(1)
	secondNode = newNode(2)
	newNode(3)

	var visited = ""
	let itr = IterNode.iterator()
	for n from itr
		visited += n.tag + ","
		if n.tag == 1
			destroy n
			destroy secondNode
	itr.close()

	visited.assertEquals("1,3,")
	clearNodes()

/* Instance ids are pooled and handed straight back out, so the node allocated right after a destroy
   reuses the dead node's id. Iteration must not resolve its position through an id it has already
   released. */
@Test function iteratorSurvivesAnIdBeingReusedMidLoop()
	clearNodes()
	newNode(1)
	newNode(2)
	newNode(3)

	var visited = ""
	let itr = IterNode.iterator()
	for n from itr
		visited += n.tag + ","
		if n.tag == 1
			destroy n
			newNode(4)
	itr.close()

	// 2 and 3 were already in the list; 4 is appended at the tail and is reached in the same pass.
	visited.assertEquals("1,2,3,4,")
	clearNodes()

/* deactivate() unlinks from the active list too, so it has to steer a parked iterator the same way
   a destroy does. Entity.update() deactivates entities that have come to rest. */
@Test function iteratorSurvivesDeactivationOfTheCachedNode()
	clearNodes()
	newNode(1)
	secondNode = newNode(2)
	newNode(3)

	var visited = ""
	let itr = IterNode.iterator()
	for n from itr
		visited += n.tag + ","
		if n.tag == 1
			secondNode.deactivate()
	itr.close()

	visited.assertEquals("1,3,")
	secondNode.activate()
	clearNodes()
